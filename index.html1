<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>JARVIS</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
  <style>
    html, body { margin: 0; overflow: hidden; background: #000; font-family: 'Courier New', monospace; }
    a-scene { background: #000; }

    #status-bar {
      position: fixed; top: 20px; left: 50%; transform: translateX(-50%);
      color: #7fd8ff; font-size: 13px; letter-spacing: 2px;
      text-shadow: 0 0 8px rgba(79,195,247,0.8);
      z-index: 999; pointer-events: none; text-align: center;
    }

    #loading-screen {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: #000; color: #7fd8ff; display: flex; flex-direction: column;
      align-items: center; justify-content: center; z-index: 2000; text-align: center; padding: 20px;
    }
    #loading-screen .bar-track {
      width: 320px; max-width: 80vw; height: 10px; border: 1px solid #4fc3f7;
      border-radius: 6px; margin-top: 20px; overflow: hidden;
    }
    #loading-screen .bar-fill { height: 100%; width: 0%; background: #4fc3f7; transition: width .2s; }

    .a-enter-vr-button {
      background: radial-gradient(circle, rgba(79,195,247,0.25), rgba(5,15,25,0.9)) !important;
      border: 2px solid #4fc3f7 !important;
      box-shadow: 0 0 20px rgba(79,195,247,0.6) !important;
    }
  </style>
</head>
<body>

  <div id="loading-screen">
    <h2 style="letter-spacing:3px;">JARVIS — LOADING</h2>
    <p id="loading-text" style="max-width:480px; line-height:1.5; font-size:13px; opacity:.85;">
      Downloading the AI model to this device. One-time only — after this, everything runs fully offline, no account needed.
    </p>
    <div class="bar-track"><div id="progress-fill" class="bar-fill"></div></div>
    <p id="progress-pct" style="margin-top:10px; font-size:12px;">0%</p>
  </div>

  <div id="status-bar">LOADING...</div>

  <a-scene background="color: #000005">
    <a-assets></a-assets>

    <a-sky id="sky" color="#00040a"></a-sky>
    <a-entity id="void-particles"></a-entity>

    <a-entity geometry="primitive: plane; width: 40; height: 40" rotation="-90 0 0"
      material="color: #051826; opacity: 0.4; wireframe: true" position="0 -1.6 0">
    </a-entity>

    <a-entity id="hud-ring" position="0 1.4 -1.4">
      <a-sphere id="core-sphere" radius="0.04" color="#7fe0ff"
        material="shader: flat; emissive: #7fe0ff; emissiveIntensity: 1"
        animation="property: scale; to: 1.3 1.3 1.3; dir: alternate; loop: true; dur: 1400; easing: easeInOutSine">
      </a-sphere>
      <a-torus id="ring-inner" color="#4fc3f7" radius="0.32" radius-tubular="0.004"
        material="shader: flat; opacity: 0.7; emissive: #4fc3f7; emissiveIntensity: 0.9"
        rotation="90 0 0"
        animation="property: rotation; to: 90 0 360; loop: true; dur: 14000; easing: linear">
      </a-torus>
      <a-entity id="tick-ring-mid" rotation="90 0 0"
        animation="property: rotation; to: 90 0 -360; loop: true; dur: 22000; easing: linear"></a-entity>
      <a-torus id="ring-outer" color="#4fc3f7" radius="0.75" radius-tubular="0.002"
        material="shader: flat; opacity: 0.35; emissive: #4fc3f7; emissiveIntensity: 0.6"
        rotation="90 0 0"
        animation="property: rotation; to: 90 0 360; loop: true; dur: 30000; easing: linear">
      </a-torus>
      <a-entity id="tick-ring-outer" rotation="90 0 0"
        animation="property: rotation; to: 90 0 -360; loop: true; dur: 40000; easing: linear"></a-entity>
      <a-torus id="scan-arc" color="#a9e8ff" radius="0.5" radius-tubular="0.006"
        theta-start="0" theta-length="40"
        material="shader: flat; opacity: 0.8; emissive: #a9e8ff; emissiveIntensity: 1"
        rotation="90 0 0"
        animation="property: rotation; to: 90 0 -360; loop: true; dur: 5000; easing: linear">
      </a-torus>
    </a-entity>

    <a-entity id="hud-panel" position="0 1.4 -1.35">
      <a-plane width="0.9" height="0.4" color="#04121c" opacity="0.5" material="shader: flat"></a-plane>
      <a-text id="hud-text" value="Say 'Jarvis' to begin." align="center" width="1.5" color="#a9e8ff" position="0 0 0.01"></a-text>
    </a-entity>

    <a-entity id="data-left" position="-0.85 1.55 -1.5" rotation="0 25 0">
      <a-plane width="0.35" height="0.22" color="#04121c" opacity="0.4" material="shader: flat"></a-plane>
      <a-text id="data-left-text" value="PWR: 100%\nMODE: STANDARD\nSTATUS: IDLE" align="left" width="1" color="#5fc7ea" position="-0.16 0 0.01" wrap-count="18"></a-text>
    </a-entity>
    <a-entity id="data-right" position="0.85 1.55 -1.5" rotation="0 -25 0">
      <a-plane width="0.35" height="0.22" color="#04121c" opacity="0.4" material="shader: flat"></a-plane>
      <a-text id="data-right-text" value="CORE: STABLE\nAUDIO: READY\nAWAITING WAKE WORD" align="left" width="1" color="#5fc7ea" position="-0.16 0 0.01" wrap-count="18"></a-text>
    </a-entity>

    <a-entity id="activate-btn" position="0 1.1 -1.2" geometry="primitive: circle; radius: 0.11"
      material="color: #0a2e40; shader: flat; opacity: 0.85" class="clickable">
      <a-ring color="#4fc3f7" radius-inner="0.105" radius-outer="0.115"
        material="shader: flat; emissive: #4fc3f7; emissiveIntensity: 0.9" position="0 0 0.001"></a-ring>
      <a-text value="TAP ONCE\nTO ACTIVATE" align="center" width="0.7" color="#cfefff" position="0 0 0.002"></a-text>
    </a-entity>

    <a-entity laser-controls="hand: right" raycaster="objects: .clickable; far: 20"></a-entity>
    <a-entity laser-controls="hand: left" raycaster="objects: .clickable; far: 20"></a-entity>

    <a-entity camera position="0 1.6 0" look-controls wasd-controls>
      <a-cursor raycaster="objects: .clickable" fuse="true" fuse-timeout="1200"></a-cursor>
    </a-entity>
  </a-scene>

  <script type="module">
    import { CreateMLCEngine } from "https://esm.run/@mlc-ai/web-llm";

    const loadingScreen = document.getElementById('loading-screen');
    const loadingText = document.getElementById('loading-text');
    const progressFill = document.getElementById('progress-fill');
    const progressPct = document.getElementById('progress-pct');
    const statusBar = document.getElementById('status-bar');
    const hudText = document.getElementById('hud-text');
    const dataLeftText = document.getElementById('data-left-text');
    const dataRightText = document.getElementById('data-right-text');
    const activateBtn = document.getElementById('activate-btn');
    const sky = document.getElementById('sky');
    const ringInner = document.getElementById('ring-inner');
    const ringOuter = document.getElementById('ring-outer');
    const coreSphere = document.getElementById('core-sphere');

    function setStatus(t) {
      statusBar.textContent = t;
      dataRightText.setAttribute('value', 'CORE: STABLE\\nAUDIO: ACTIVE\\n' + t.slice(0, 16));
    }
    function setHud(t) { hudText.setAttribute('value', t); }

    const voidContainer = document.getElementById('void-particles');
    for (let i = 0; i < 200; i++) {
      const p = document.createElement('a-sphere');
      const r = 6 + Math.random() * 14;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.random() * Math.PI;
      p.setAttribute('radius', 0.008 + Math.random() * 0.015);
      p.setAttribute('color', '#4fc3f7');
      p.setAttribute('material', 'shader: flat; opacity: ' + (0.2 + Math.random() * 0.5));
      p.setAttribute('position', {
        x: r * Math.sin(phi) * Math.cos(theta), y: r * Math.cos(phi), z: r * Math.sin(phi) * Math.sin(theta)
      });
      voidContainer.appendChild(p);
    }

    function buildTickRing(containerId, radius, tickCount, tickLength, opacity) {
      const container = document.getElementById(containerId);
      for (let i = 0; i < tickCount; i++) {
        const angle = (i / tickCount) * Math.PI * 2;
        const tick = document.createElement('a-box');
        tick.setAttribute('width', 0.006);
        tick.setAttribute('height', tickLength);
        tick.setAttribute('depth', 0.002);
        tick.setAttribute('color', '#7fd8ff');
        tick.setAttribute('material', 'shader: flat; opacity: ' + opacity + '; emissive: #7fd8ff; emissiveIntensity: 0.7');
        tick.setAttribute('position', { x: radius * Math.cos(angle), y: radius * Math.sin(angle), z: 0 });
        tick.setAttribute('rotation', { x: 0, y: 0, z: (angle * 180 / Math.PI) + 90 });
        container.appendChild(tick);
      }
    }
    buildTickRing('tick-ring-mid', 0.45, 40, 0.025, 0.6);
    buildTickRing('tick-ring-outer', 0.9, 60, 0.03, 0.35);

    let battleMode = false;
    function setBattleMode(on) {
      battleMode = on;
      const color = on ? '#ff5252' : '#4fc3f7';
      const skyColor = on ? '#0a0002' : '#00040a';
      sky.setAttribute('color', skyColor);
      [ringInner, ringOuter].forEach(r => {
        r.setAttribute('color', color);
        r.setAttribute('material', 'shader: flat; opacity: 0.7; emissive: ' + color + '; emissiveIntensity: 0.9');
      });
      coreSphere.setAttribute('color', on ? '#ff8080' : '#7fe0ff');
      coreSphere.setAttribute('material', 'shader: flat; emissive: ' + (on ? '#ff8080' : '#7fe0ff') + '; emissiveIntensity: 1');
      dataLeftText.setAttribute('value', on ? 'PWR: 100%\\nMODE: BATTLE\\nSTATUS: ENGAGED' : 'PWR: 100%\\nMODE: STANDARD\\nSTATUS: IDLE');
    }

    let engine = null;
    async function initEngine() {
      if (!navigator.gpu) {
        loadingText.textContent = "This browser doesn't support WebGPU, which the on-device brain needs. Try updating the Quest Browser.";
        return;
      }
      try {
        engine = await CreateMLCEngine("Llama-3.2-1B-Instruct-q4f16_1-MLC", {
          initProgressCallback: (progress) => {
            const pct = Math.round((progress.progress || 0) * 100);
            progressFill.style.width = pct + '%';
            progressPct.textContent = pct + '%';
          }
        });
        loadingScreen.style.display = 'none';
        setStatus("TAP THE RING TO ACTIVATE");
      } catch (err) {
        loadingText.textContent = "Couldn't load the model. Try reloading the page.";
        console.error(err);
      }
    }
    initEngine();

    function speak(text) {
      const utter = new SpeechSynthesisUtterance(text);
      const voices = speechSynthesis.getVoices();
      const preferred = voices.find(v => /en-US|en-GB/.test(v.lang) && /Male|Guy|Daniel|Christopher/i.test(v.name))
                       || voices.find(v => /en-US|en-GB/.test(v.lang));
      if (preferred) utter.voice = preferred;
      utter.rate = 1.02;
      utter.pitch = 0.95;
      speechSynthesis.speak(utter);
    }

    async function askJarvis(userText) {
      if (!engine) { setHud("Still loading, Sir."); return; }
      setStatus("THINKING...");
      setHud("...");
      try {
        const reply = await engine.chat.completions.create({
          messages: [
            { role: "system", content: "You are JARVIS, a sharp, articulate assistant in the style of a young professional. Address the user as 'Sir' when it fits naturally. Keep replies concise and conversational since they'll be spoken aloud." },
            { role: "user", content: userText }
          ]
        });
        const text = reply.choices[0].message.content;
        setHud(text);
        setStatus("LISTENING FOR \"JARVIS\"...");
        speak(text);
      } catch (err) {
        setHud("Something went wrong, Sir.");
        setStatus("ERROR");
        console.error(err);
      }
    }

    function handleCommand(text) {
      const t = text.toLowerCase();

      if (t.includes("shut down") || t.includes("shutdown")) {
        setHud("Shutting down. Goodbye, Sir.");
        speak("Shutting down. Goodbye, Sir.");
        setStatus("SHUTTING DOWN");
        setTimeout(() => { active = false; if (recognizer) recognizer.stop(); }, 2000);
        return true;
      }
      if (t.includes("power off")) {
        setHud("Powering off.");
        speak("Powering off.");
        const scene = document.querySelector('a-scene');
        if (scene && scene.exitVR) setTimeout(() => scene.exitVR(), 1500);
        return true;
      }
      if (t.includes("activate battle mode") || t.includes("battle mode")) {
        setBattleMode(true);
        const lines = ["Engaging.", "Activating battle systems.", "Prepping, Sir."];
        const line = lines[Math.floor(Math.random() * lines.length)];
        setHud(line);
        speak(line);
        return true;
      }
      if (t.includes("stand down") || t.includes("standard mode")) {
        setBattleMode(false);
        setHud("Standing down.");
        speak("Standing down.");
        return true;
      }
      return false;
    }

    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    const recognizer = SpeechRecognition ? new SpeechRecognition() : null;
    if (recognizer) { recognizer.continuous = true; recognizer.interimResults = false; recognizer.lang = 'en-US'; }

    const WAKE_WORD = "jarvis";
    let awaitingCommand = false;
    let active = false;

    function activateJarvis() {
      if (active || !recognizer) return;
      active = true;
      activateBtn.setAttribute('visible', 'false');
      setStatus("LISTENING FOR \"JARVIS\"...");
      setHud('Say "Jarvis" any time, Sir.');
      recognizer.start();
    }

    if (recognizer) {
      recognizer.onresult = (e) => {
        const result = e.results[e.results.length - 1];
        if (!result.isFinal) return;
        const transcript = result[0].transcript.trim();
        const lower = transcript.toLowerCase();

        if (awaitingCommand) {
          awaitingCommand = false;
          if (handleCommand(transcript)) return;
          setHud('"' + transcript + '"');
          askJarvis(transcript);
          return;
        }

        if (lower.includes(WAKE_WORD)) {
          const idx = lower.indexOf(WAKE_WORD);
          const afterWake = transcript.slice(idx + WAKE_WORD.length).replace(/^[,.\s]+/, '');
          if (afterWake.length > 2) {
            if (handleCommand(afterWake)) return;
            setHud('"' + afterWake + '"');
            askJarvis(afterWake);
          } else {
            setStatus("LISTENING...");
            setHud("Sir?");
            speak("Sir?");
            awaitingCommand = true;
          }
        }
      };

      recognizer.onend = () => { if (active) recognizer.start(); };
      recognizer.onerror = (e) => { if (e.error !== 'no-speech') console.error(e); };
    }

    activateBtn.addEventListener('click', activateJarvis);

    document.querySelector('a-scene').addEventListener('enter-vr', () => {
      setTimeout(activateJarvis, 500);
    });

    window.addEventListener('load', () => {
      setTimeout(() => { if (!window.AFRAME) setStatus("3D ENGINE FAILED TO LOAD"); }, 3000);
    });
  </script>
</body>
</html>
